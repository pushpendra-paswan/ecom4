# Copy to .env and fill in real values:  cp .env.example .env
# Docker Compose reads .env automatically. Never commit .env.

# ---------- Postgres (one container, one database per service) ----------
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
# SQLAlchemy URLs (psycopg 3 driver). Keep user/password in sync with the two lines above.
IDENTITY_DATABASE_URL=postgresql+psycopg://support:change-me@postgres:5432/identity_db
TICKET_DATABASE_URL=postgresql+psycopg://support:change-me@postgres:5432/ticket_db
ORDER_DATABASE_URL=postgresql+psycopg://support:change-me@postgres:5432/order_db
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://support:change-me@postgres:5432/knowledge_db
AGENT_DATABASE_URL=postgresql+psycopg://support:change-me@postgres:5432/agent_db

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- RabbitMQ (same user/password logs into the management UI on :15672) ----------
RABBITMQ_USER=support
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://support:change-me@rabbitmq:5672/

# ---------- JWT (RS256 keys come from `python scripts/generate_keys.py`) ----------
# Paths inside the containers. Only identity gets the private key.
JWT_PRIVATE_KEY_PATH=/keys/private/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- OpenAI (used from M4 onwards) ----------
OPENAI_API_KEY=sk-replace-me
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Business rules (used from M9) ----------
# Refunds at or below this amount (mock INR) are auto-approved by the Ticket service
REFUND_AUTO_APPROVE_LIMIT=5000
